PORT=5000
NODE_ENV=development

# PostgreSQL connection string (required). Free managed Postgres: https://neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
# Set to false only for a local Postgres without SSL
DATABASE_SSL=true

JWT_SECRET=change-me-to-a-real-secret
JWT_EXPIRES_IN=7d

# WhatsApp Cloud API — set real values to enable messaging
WHATSAPP_TOKEN=test
WHATSAPP_PHONE_NUMBER_ID=test
WHATSAPP_VERIFY_TOKEN=test-verify
# Only set this in production (Meta app secret used for webhook signature verification)
WHATSAPP_APP_SECRET=

DEFAULT_COUNTRY=PK
DEFAULT_CURRENCY=PKR